cabal-version:      2.4
name:               poketeam
version:            1.0.0
synopsis:           Backend em Haskell para gerenciamento de Pokédex e Times Pokémon
description:        API REST desenvolvida em Haskell com Servant para demonstração acadêmica de programação funcional.
license:            MIT
author:             PokéTeam Contributors
maintainer:         poketeam@example.com
build-type:         Simple

flag use-mysql
  description: Habilita suporte ao banco MySQL (requer mysql_config e biblioteca C pcre instaladas no sistema)
  default:     False
  manual:      True

common common-options
  default-language:   Haskell2010
  ghc-options:        -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wmissing-export-lists
                      -Wmissing-home-modules
                      -Wpartial-fields
                      -Wredundant-constraints
  cpp-options:        -DWITH_AESON

library
  import:             common-options
  hs-source-dirs:     src
  exposed-modules:    Models.Pokemon
                    , Models.Team
                    , Services.PokemonService
                    , Services.TeamService
                    , Database.InMemoryRepository
                    , Database.Connection
                    , Database.PokemonRepository
                    , API.Routes
  build-depends:      base >= 4.14 && < 5
                    , aeson >= 2.0
                    , servant >= 0.19
                    , servant-server >= 0.19
                    , warp >= 3.3
                    , wai >= 3.2
                    , wai-cors >= 0.2
                    , text >= 1.2
                    , bytestring >= 0.10
                    , split >= 0.2
  if flag(use-mysql)
    cpp-options:      -DUSE_MYSQL
    build-depends:    mysql-simple >= 0.4

executable poketeam-server
  import:             common-options
  hs-source-dirs:     app
  main-is:            Main.hs
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
  build-depends:      base >= 4.14 && < 5
                    , poketeam
                    , warp
  if flag(use-mysql)
    cpp-options:      -DUSE_MYSQL
    build-depends:    mysql-simple

test-suite poketeam-test
  import:             common-options
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
  build-depends:      base >= 4.14 && < 5
                    , poketeam
